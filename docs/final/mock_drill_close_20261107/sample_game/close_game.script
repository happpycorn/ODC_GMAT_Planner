% ODC medal drill replay (close scenario): we = evader, opponent seed 1; made by gmat_replay.py
Create Spacecraft SC_Alpha;
SC_Alpha.DateFormat = UTCGregorian;
SC_Alpha.Epoch = '09 Nov 2026 07:00:00.000';
SC_Alpha.CoordinateSystem = EarthMJ2000Eq;
SC_Alpha.DisplayStateType = Cartesian;
SC_Alpha.X = 5609.964913000000;
SC_Alpha.Y = -2552.813699000000;
SC_Alpha.Z = 4314.531061000000;
SC_Alpha.VX = 3.873227653000;
SC_Alpha.VY = 5.916660612000;
SC_Alpha.VZ = -2.708140978000;
SC_Alpha.DryMass = 500;
SC_Alpha.OrbitColor = [235 104 52];
SC_Alpha.TargetColor = [235 104 52];
Create Spacecraft SC_Beta;
SC_Beta.DateFormat = UTCGregorian;
SC_Beta.Epoch = '09 Nov 2026 07:00:00.000';
SC_Beta.CoordinateSystem = EarthMJ2000Eq;
SC_Beta.DisplayStateType = Cartesian;
SC_Beta.X = 4966.906681000000;
SC_Beta.Y = -2453.674985000000;
SC_Beta.Z = 4096.856193000000;
SC_Beta.VX = 4.568216137000;
SC_Beta.VY = 5.710891857000;
SC_Beta.VZ = -2.105695199000;
SC_Beta.DryMass = 500;
SC_Beta.OrbitColor = [42 120 214];
SC_Beta.TargetColor = [42 120 214];

Create ForceModel FM;
FM.CentralBody = Earth;
FM.PrimaryBodies = {Earth};
FM.Drag = None;
FM.SRP = Off;
FM.RelativisticCorrection = Off;
FM.ErrorControl = RSSStep;
FM.GravityField.Earth.Degree = 0;
FM.GravityField.Earth.Order = 0;
FM.GravityField.Earth.PotentialFile = 'JGM2.cof';

Create Propagator Prop;
Prop.FM = FM;
Prop.Type = RungeKutta89;
Prop.InitialStepSize = 10;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0.001;
Prop.MaxStep = 5;

% Evader-centred RSW: X = radial (up +), Y = along-track (ahead +), Z = orbit normal
Create CoordinateSystem EvaderRSW;
EvaderRSW.Origin = SC_Beta;
EvaderRSW.Axes = ObjectReferenced;
EvaderRSW.XAxis = R;
EvaderRSW.ZAxis = N;
EvaderRSW.Primary = Earth;
EvaderRSW.Secondary = SC_Beta;
Create ImpulsiveBurn R1_P;
R1_P.CoordinateSystem = EarthMJ2000Eq;
R1_P.Element1 = -0.161666104508;
R1_P.Element2 = 0.094766982919;
R1_P.Element3 = 0.069880538076;
R1_P.DecrementMass = false;
Create ImpulsiveBurn R1_E;
R1_E.CoordinateSystem = EarthMJ2000Eq;
R1_E.Element1 = 0.123111200000;
R1_E.Element2 = 0.150489000000;
R1_E.Element3 = -0.046655000000;
R1_E.DecrementMass = false;
Create ImpulsiveBurn R2_P;
R2_P.CoordinateSystem = EarthMJ2000Eq;
R2_P.Element1 = 0.130110003105;
R2_P.Element2 = 0.143427288519;
R2_P.Element3 = 0.050000000000;
R2_P.DecrementMass = false;
Create ImpulsiveBurn R2_E;
R2_E.CoordinateSystem = EarthMJ2000Eq;
R2_E.Element1 = -0.059416500000;
R2_E.Element2 = 0.155591400000;
R2_E.Element3 = -0.110639000000;
R2_E.DecrementMass = false;
Create ImpulsiveBurn R3_P;
R3_P.CoordinateSystem = EarthMJ2000Eq;
R3_P.Element1 = 0.183579252366;
R3_P.Element2 = -0.062422516265;
R3_P.Element3 = -0.049011096333;
R3_P.DecrementMass = false;
Create ImpulsiveBurn R3_E;
R3_E.CoordinateSystem = EarthMJ2000Eq;
R3_E.Element1 = -0.177530300000;
R3_E.Element2 = 0.013131300000;
R3_E.Element3 = -0.091052400000;
R3_E.DecrementMass = false;
Create ImpulsiveBurn R4_P;
R4_P.CoordinateSystem = EarthMJ2000Eq;
R4_P.Element1 = -0.131301540065;
R4_P.Element2 = -0.079855920400;
R4_P.Element3 = -0.127995849752;
R4_P.DecrementMass = false;
Create ImpulsiveBurn R4_E;
R4_E.CoordinateSystem = EarthMJ2000Eq;
R4_E.Element1 = -0.186635200000;
R4_E.Element2 = -0.070230100000;
R4_E.Element3 = -0.014663000000;
R4_E.DecrementMass = false;
Create ImpulsiveBurn R5_P;
R5_P.CoordinateSystem = EarthMJ2000Eq;
R5_P.Element1 = -0.193807546613;
R5_P.Element2 = -0.017962039859;
R5_P.Element3 = 0.046000000000;
R5_P.DecrementMass = false;
Create ImpulsiveBurn R5_E;
R5_E.CoordinateSystem = EarthMJ2000Eq;
R5_E.Element1 = -0.081816500000;
R5_E.Element2 = -0.179375300000;
R5_E.Element3 = 0.033325000000;
R5_E.DecrementMass = false;
Create ImpulsiveBurn R6_E;
R6_E.CoordinateSystem = EarthMJ2000Eq;
R6_E.Element1 = 0.093129000000;
R6_E.Element2 = -0.175115700000;
R6_E.Element3 = 0.025327000000;
R6_E.DecrementMass = false;

Create Variable Dist I;
Create ReportFile Rep;
Rep.Filename = '/Users/corn/Documents/Program/ODC_Program/docs/final/mock_drill_close_20261107/sample_game/close_game_report.txt';
Rep.Precision = 16;
Rep.WriteHeaders = false;

Create OrbitView View3D;
View3D.Add = {SC_Alpha, SC_Beta, Earth};
View3D.CoordinateSystem = EarthMJ2000Eq;
View3D.ViewPointReference = Earth;
View3D.ViewDirection = Earth;
View3D.ViewScaleFactor = 2.5;
View3D.ViewUpCoordinateSystem = EarthMJ2000Eq;
View3D.ViewUpAxis = Z;
View3D.Axes = On;
View3D.Grid = Off;
View3D.EnableConstellations = Off;
View3D.SolverIterations = None;

Create OrbitView RelView;
RelView.Add = {SC_Alpha, SC_Beta};
RelView.CoordinateSystem = EvaderRSW;
RelView.ViewPointReference = SC_Beta;
RelView.ViewPointVector = [0 0 300];
RelView.ViewDirection = SC_Beta;
RelView.ViewScaleFactor = 1;
RelView.ViewUpCoordinateSystem = EvaderRSW;
RelView.ViewUpAxis = X;
RelView.Axes = On;
RelView.Grid = On;
RelView.EnableConstellations = Off;
RelView.SolverIterations = None;

Create XYPlot DistPlot;
DistPlot.XVariable = SC_Alpha.ElapsedSecs;
DistPlot.YVariables = {Dist};
DistPlot.ShowGrid = true;
DistPlot.SolverIterations = None;

Create XYPlot SmaPlot;
SmaPlot.XVariable = SC_Alpha.ElapsedSecs;
SmaPlot.YVariables = {SC_Alpha.Earth.SMA, SC_Beta.Earth.SMA};
SmaPlot.ShowGrid = true;
SmaPlot.SolverIterations = None;

BeginMissionSequence;
Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
% ---- round 1 ----
Maneuver R1_P(SC_Alpha);
Maneuver R1_E(SC_Beta);
For I = 1:1:180;
   Propagate Synchronized Prop(SC_Alpha, SC_Beta) {SC_Alpha.ElapsedSecs = 5.0};
   Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
   Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
EndFor;
% ---- round 2 ----
Maneuver R2_P(SC_Alpha);
Maneuver R2_E(SC_Beta);
For I = 1:1:180;
   Propagate Synchronized Prop(SC_Alpha, SC_Beta) {SC_Alpha.ElapsedSecs = 5.0};
   Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
   Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
EndFor;
% ---- round 3 ----
Maneuver R3_P(SC_Alpha);
Maneuver R3_E(SC_Beta);
For I = 1:1:180;
   Propagate Synchronized Prop(SC_Alpha, SC_Beta) {SC_Alpha.ElapsedSecs = 5.0};
   Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
   Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
EndFor;
% ---- round 4 ----
Maneuver R4_P(SC_Alpha);
Maneuver R4_E(SC_Beta);
For I = 1:1:180;
   Propagate Synchronized Prop(SC_Alpha, SC_Beta) {SC_Alpha.ElapsedSecs = 5.0};
   Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
   Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
EndFor;
% ---- round 5 ----
Maneuver R5_P(SC_Alpha);
Maneuver R5_E(SC_Beta);
For I = 1:1:180;
   Propagate Synchronized Prop(SC_Alpha, SC_Beta) {SC_Alpha.ElapsedSecs = 5.0};
   Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
   Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
EndFor;
% ---- round 6 ----
Maneuver R6_E(SC_Beta);
For I = 1:1:180;
   Propagate Synchronized Prop(SC_Alpha, SC_Beta) {SC_Alpha.ElapsedSecs = 5.0};
   Dist = sqrt((SC_Alpha.X - SC_Beta.X)^2 + (SC_Alpha.Y - SC_Beta.Y)^2 + (SC_Alpha.Z - SC_Beta.Z)^2);
   Report Rep SC_Alpha.ElapsedSecs SC_Alpha.X SC_Alpha.Y SC_Alpha.Z SC_Beta.X SC_Beta.Y SC_Beta.Z SC_Alpha.EvaderRSW.X SC_Alpha.EvaderRSW.Y SC_Alpha.EvaderRSW.Z Dist;
EndFor;
