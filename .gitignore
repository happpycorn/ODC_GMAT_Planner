# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 本機設定與臨時情境留在 configs/local/，不進版控。
# configs/shared/ 的所有共用情境皆納入版控，不放本機 GMAT 路徑。
configs/*
!configs/shared/
!configs/shared/**

outputs/*

# Claude/夜跑產出的暫存目錄（規劃筆記、bundle zip 等），比照 outputs/ 可拋、不進版控
Claude outputs/
