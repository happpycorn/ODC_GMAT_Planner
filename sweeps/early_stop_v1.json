{
  "name": "early_stop_v1",
  "_說明": "提早停止 on/off 配對消融；沿用 budget_v1 四個快情境、五顆 SEED、600×20。每組同種子比較拆後分數、代數與 CPU 秒。",
  "scenarios": [
    {
      "name": "contest",
      "config": "configs/contest.json",
      "overrides": {
        "optimization.MAX_BURNS": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "contest_fastT",
      "config": "configs/contest.json",
      "overrides": {
        "optimization.MAX_BURNS": [
          1,
          2,
          3
        ],
        "rules.C_t": 5000.0
      },
      "_說明": "同幾何、時間項收緊（C_t 6505→5000）：現行路線時間分 24.1→1.6，測結論換權重還成不成立"
    },
    {
      "name": "official_sample",
      "config": "configs/official_sample.json"
    },
    {
      "name": "hyper_far",
      "config": "configs/hyper_far.json"
    }
  ],
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "variants": {
    "off": {
      "optimization.EARLY_STOP_ENABLED": false
    },
    "on": {
      "optimization.EARLY_STOP_ENABLED": true
    }
  },
  "base": {
    "optimization.MAXITER": 600,
    "optimization.POPSIZE": 20
  }
}
